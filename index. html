<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f6f8;
            color: #222;
        }

        header {
            background-color: #1f2937;
            color: white;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        nav a:hover {
            color: #60a5fa;
        }

        .hero {
            text-align: center;
            padding: 80px 20px;
            background-color: white;
        }

        .hero h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #555;
        }

        section {
            padding: 50px 10%;
        }

        section h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 30px;
        }

        .about {
            text-align: center;
            line-height: 1.7;
        }

        .skills {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .skill {
            background-color: white;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0 2px 8px #ccc;
        }

        .projects {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .project {
            background-color: white;
            padding: 25px;
            width: 280px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .project h3 {
            margin-bottom: 10px;
        }

        .education {
            background-color: white;
            text-align: center;
            line-height: 1.8;
        }

        .contact {
            text-align: center;
            background-color: #e5e7eb;
            line-height: 2;
        }

        footer {
            background-color: #1f2937;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 5px;
            }

            .hero h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>My Portfolio</h1>

        <nav>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#education">Education</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Home -->
    <div class="hero">
        <h2>Hi, I'm Sai Vinuthna 👋</h2>
        <p>BCA Data Science Student | Python Learner | Aspiring Data Professional</p>
    </div>

    <!-- About -->
    <section id="about">
        <h2>About Me</h2>

        <div class="about">
            <p>
                I am a BCA Data Science student interested in programming,
                data science and technology. I am currently improving my
                Python and problem-solving skills and building projects
                to gain practical experience.
            </p>
        </div>
    </section>

    <!-- Skills -->
    <section id="skills">
        <h2>My Skills</h2>

        <div class="skills">
            <div class="skill">HTML</div>
            <div class="skill">CSS</div>
            <div class="skill">Python</div>
            <div class="skill">Data Science</div>
            <div class="skill">SQL</div>
            <div class="skill">Problem Solving</div>
        </div>
    </section>

    <!-- Projects -->
    <section id="projects">
        <h2>My Projects</h2>

        <div class="projects">

            <div class="project">
                <h3>Python Calculator</h3>
                <p>
                    A simple calculator developed using Python
                    to perform basic mathematical operations.
                </p>
            </div>

            <div class="project">
                <h3>Student Management System</h3>
                <p>
                    A beginner project for storing and managing
                    student information.
                </p>
            </div>

            <div class="project">
                <h3>Data Analysis Project</h3>
                <p>
                    A project to explore and analyze data using
                    Python and basic data science concepts.
                </p>
            </div>

        </div>
    </section>

    <!-- Education -->
    <section id="education">
        <h2>Education</h2>

        <div class="education">
            <h3>BCA - Data Science</h3>
            <p>Aditya Degree College</p>
            <p>Currently pursuing my degree</p>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact">
        <h2>Contact Me</h2>

        <div class="contact">
            <p>Email: yourmail@gmail.com</p>
            <p>Phone: +91 XXXXX XXXXX</p>
            <p>Location: Andhra Pradesh, India</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 My Portfolio. All Rights Reserved.</p>
    </footer>

</body>
</html>
